# 在 DeepSeek 控制台创建 API Key，只填在服务器环境变量里，不要提交到 Git
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 可选：几个朋友共用的「口令」，与前端 config.js 里的 defaultProxyToken 一致
# 不设置则不要求客户端带 Token（仅适合完全私网或测试）
# FRIEND_TOKEN=你们小群的共享口令

# 允许的前端来源，逗号分隔；* 表示任意（小规模朋友用时方便）
CORS_ORIGIN=*

# 服务端口
PORT=8787

# 模型：deepseek-chat 或 deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
